<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="H2">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>roofsense.entities.Roof</class>

        <properties>
            <!-- Database Connection Properties -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL"/>
            <!--
                "DB_CLOSE_DELAY=-1" prevents the db from closing when there are no active connections,
                     which improves test execution speed
                "MODE=PostgreSQL" since we intend to migrate to PostgreSQL or derivatives later
            -->
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Schema Generation (set to 'validate' in production) -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>
</persistence>
