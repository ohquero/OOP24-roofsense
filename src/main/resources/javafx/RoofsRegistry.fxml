<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:id="roofsRegistryRootNode"
      stylesheets="@style.css"
      fx:controller="roofsense.adapters.ui.RoofsRegistry">
    <Label styleClass="h1" text="Roofs"/>
    <TextField fx:id="searchRoofsTextField" promptText="Search..."/>
    <TableView fx:id="roofsTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="roofsTableCodeColumn" minWidth="80.0" prefWidth="-1.0" text="Code"/>
            <TableColumn fx:id="roofsTableBuildingAddressColumn" minWidth="300.0" prefWidth="-1.0"
                         text="Building address"/>
        </columns>
    </TableView>
    <GridPane>
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints vgrow="NEVER"/>
        </rowConstraints>
        <AnchorPane>
            <Button fx:id="addNewRoofButton" mnemonicParsing="false" text="Add" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        </AnchorPane>
        <AnchorPane GridPane.columnIndex="1">
            <Button fx:id="editRoofButton" mnemonicParsing="false" text="Edit" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        </AnchorPane>
        <AnchorPane GridPane.columnIndex="2">
            <Button fx:id="removeRoofButton" mnemonicParsing="false" text="Delete" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        </AnchorPane>
    </GridPane>
</VBox>
